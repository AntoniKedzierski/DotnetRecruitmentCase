<Window 
    x:Class="InvoicesDesktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:InvoicesDesktop"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:vm="clr-namespace:InvoicesDesktop.ViewModels"
    mc:Ignorable="d"
    Title="Invoices Desktop"
    Height="760"
    Width="1180"
    WindowStartupLocation="CenterScreen"
    FontFamily="{StaticResource LatoFont}"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextElement.FontWeight="Regular"
    TextElement.FontSize="13"
    Background="{DynamicResource MaterialDesignPaper}"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <materialDesign:DialogHost Identifier="RootDialog"
                               DialogTheme="Inherit"
                               CloseOnClickAway="False">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation rail -->
            <materialDesign:Card Grid.Column="0" UniformCornerRadius="0"
                                 materialDesign:ElevationAssist.Elevation="Dp3"
                                 Background="{DynamicResource MaterialDesignPaper}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="20,24,20,16">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ReceiptText" Width="30" Height="30"
                                                     VerticalAlignment="Center"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}" />
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Invoices"
                                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                           FontWeight="Bold" />
                                <TextBlock Text="Management studio"
                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                           Opacity="0.6" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Separator DockPanel.Dock="Top"
                               Style="{StaticResource MaterialDesignLightSeparator}"
                               Margin="0,0,0,8" />

                    <ListBox DockPanel.Dock="Top"
                             ItemsSource="{Binding Sections}"
                             SelectedItem="{Binding CurrentSection}"
                             Style="{StaticResource MaterialDesignNavigationPrimaryListBox}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,0">
                                    <materialDesign:PackIcon Kind="{Binding Icon}"
                                                             Width="22" Height="22"
                                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}"
                                               Margin="18,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="14" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </materialDesign:Card>

            <!-- Content area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid"
                                          materialDesign:ElevationAssist.Elevation="Dp4"
                                          Padding="24,16">
                    <DockPanel>
                        <materialDesign:PackIcon DockPanel.Dock="Left"
                                                 Kind="{Binding CurrentSection.Icon}"
                                                 Width="26" Height="26"
                                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentSection.Title}"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}" />
                    </DockPanel>
                </materialDesign:ColorZone>

                <ContentControl Grid.Row="1" Content="{Binding CurrentSection}" />
            </Grid>

            <materialDesign:Snackbar Grid.ColumnSpan="2"
                                     MessageQueue="{Binding MessageQueue}"
                                     VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                     Margin="0,0,0,16" />
        </Grid>
    </materialDesign:DialogHost>
</Window>
